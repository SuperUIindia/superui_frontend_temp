# ============================================================================
# SuperUI - PRODUCTION build values (committed on purpose)
#
# .env stays git-ignored: it is the local developer's file and may hold
# machine-specific values. This file holds only PUBLIC production values, and
# every VITE_* value is inlined into the JavaScript bundle by definition, so
# there is nothing secret to leak here. Committing it means a Vercel build gets
# the right brand, SEO and GEO values with no dashboard access, instead of
# silently falling back to defaults.
#
# Precedence: real environment variables set in Vercel > this file. A value set
# in Vercel (Project > Settings > Environment Variables) wins, so a host-specific
# override never has to edit this file.
#
# SECURITY: never add ADMIN_USERNAME / ADMIN_PASSWORD / JWT_SECRET / any other
# secret. Those belong only in backend/.env.
#
# index.html carries byte-identical static values for crawlers that never run
# JavaScript. Change both together.
# ============================================================================

# --- Origin ------------------------------------------------------------------
# Apex. https://superui.in 308-redirects to https://www.superui.in, so this is
# the canonical advertised origin while both hosts serve the app.
VITE_SITE_URL=https://superui.in

# --- Branding ----------------------------------------------------------------
VITE_SITE_NAME=SuperUI
VITE_SITE_ALT_NAME=SuperUI
VITE_LOGO_PATH=/superui_logo.png
# Quoted: an unquoted value starting with # is read as a comment by dotenv and
# would load as an empty string.
VITE_THEME_COLOR="#FF5E00"

# --- SEO / AEO / GEO defaults ----------------------------------------------
VITE_SITE_LOCALE=en_IN
VITE_DEFAULT_TITLE=SuperUI — Web Development, UI/UX Design & Custom Software Studio
VITE_DEFAULT_DESCRIPTION=SuperUI is a full-stack web development and UI/UX design studio in Warangal, Telangana, India. We build fast, secure, SEO-optimised websites, e-commerce stores and custom web applications. Get a fixed-price proposal within 24 hours.
VITE_SITE_KEYWORDS=web development company Warangal, custom web application development, UI UX design services India, ecommerce website development, React and Next.js developers, website maintenance and SEO services, SuperUI
VITE_OG_IMAGE=/superui_logo.png

# --- Public business coordinates (structured data / local SEO) --------------
# Keep CITY to the city name alone. The placename shown to search engines is
# built as "<city>, <countryName>", so "Warangal, Telangana, India." here
# renders as "Warangal, Telangana, India., India".
VITE_CONTACT_EMAIL=hello.superui@gmail.com
VITE_CONTACT_PHONE=+918000000000
VITE_BUSINESS_CITY=Warangal
VITE_BUSINESS_REGION=Telangana
VITE_BUSINESS_REGION_CODE=IN-TG
VITE_BUSINESS_COUNTRY=IN
VITE_BUSINESS_COUNTRY_NAME=India
VITE_BUSINESS_POSTAL_CODE=506002
VITE_BUSINESS_LATITUDE=17.9689
VITE_BUSINESS_LONGITUDE=79.5941
VITE_AREAS_SERVED=India, United Arab Emirates, United Kingdom, United States, Singapore, Australia, Canada, Germany

# --- Social profile links ----------------------------------------------------
VITE_INSTAGRAM_URL=https://www.instagram.com/superui.in
VITE_INSTAGRAM_HANDLE=@superui.in
VITE_FACEBOOK_URL=https://www.facebook.com/superui.in
VITE_LINKEDIN_URL=https://www.linkedin.com/company/superui-in

# --- API origin --------------------------------------------------------------
# Blank means same-origin /api/..., which is correct: vercel.json proxies
# /api/:path* to the backend, so the browser only ever talks to this origin and
# no CORS or cross-site cookie policy is involved.
#
# Set this to an absolute origin ONLY if you also add this frontend's origin to
# the backend's CLIENT_URL / CORS_ORIGINS and set COOKIE_SAME_SITE=none there,
# because every request is sent with credentials: 'include'.
VITE_API_BASE_URL=

# --- Analytics / verification ------------------------------------------------
# VITE_GSC_VERIFICATION is deliberately absent: Search Console only accepts the
# token it issued for the property, and a placeholder is published as a bogus
# verification tag. Add the real token in Vercel, never a guess.
# VITE_GSC_VERIFICATION=