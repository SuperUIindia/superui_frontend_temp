# ============================================================================
# SuperUI - frontend runtime configuration (example)
# ============================================================================
# Copy this file to .env and fill in the real values. .env is git-ignored.
# VITE_* variables are inlined into the production JS bundle at build time, so
# any secret added here would be shipped to every browser. Only public values
# belong in this file.
# ============================================================================

# Public origin of this frontend.
VITE_SITE_URL=http://localhost:5173

# API origin used by the running app. BLANK means "same origin /api", which is
# correct for a Vercel deployment that rewrites /api to the backend and for
# local development behind the Vite proxy. Never set this to a localhost or
# 127.0.0.1 value - it is inlined into the production bundle at build time and
# would point every production API request at a dev machine.
VITE_API_BASE_URL=

# Vite dev-server proxy target. Dev-only: the Vite server proxies /api to this
# address so the browser can stay on localhost:5173 while the API runs on
# localhost:5000. Has no effect on production builds.
VITE_PROXY_TARGET=http://localhost:5000
VITE_PORT=5173

# Site metadata
VITE_SITE_NAME=SuperUI
VITE_SITE_ALT_NAME=SuperUI
VITE_LOGO_PATH=/superui_logo.png
VITE_THEME_COLOR=#FF5E00
VITE_SITE_LOCALE=en_IN

# SEO defaults
VITE_DEFAULT_TITLE=SuperUI — Web Development, UI/UX Design & Custom Software Studio
VITE_DEFAULT_DESCRIPTION=SuperUI is a full-stack web development and UI/UX design studio in Warangal, Telangana, India. We build fast, secure, SEO-optimised websites, e-commerce stores and custom web applications. Get a fixed-price proposal within 24 hours.

# OG image
VITE_OG_IMAGE=/superui_logo.png

# Social media URLs (leave blank to hide the icon in the footer)
VITE_INSTAGRAM_URL=https://www.instagram.com/superui.in
VITE_FACEBOOK_URL=https://www.facebook.com/superui
VITE_LINKEDIN_URL=https://www.linkedin.com/company/superui
VITE_INSTAGRAM_HANDLE=@superui.in

# Public business coordinates (SEO / AEO / GEO signals)
VITE_CONTACT_EMAIL=hello@superui.in
VITE_CONTACT_PHONE=+910000000000
VITE_BUSINESS_CITY=Warangal
VITE_BUSINESS_REGION=Telangana
VITE_BUSINESS_REGION_CODE=IN-TS
VITE_BUSINESS_COUNTRY=IN
VITE_BUSINESS_COUNTRY_NAME=India
VITE_BUSINESS_POSTAL_CODE=506001
VITE_BUSINESS_LATITUDE=17.9980
VITE_BUSINESS_LONGITUDE=79.5940
VITE_AREAS_SERVED=Warangal,Hyderabad,India