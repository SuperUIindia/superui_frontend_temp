# ============================================================================
# SuperUI - frontend runtime configuration (example)
# ============================================================================
#
# Copy this file to .env for local development. .env is git-ignored on purpose:
# VITE_* values are inlined into the public JS bundle at build time, so a
# committed .env would expose its content to every visitor.
#
# Only three values are needed. Everything else (site copy, SEO, services,
# popups, branding, social links, business coordinates) is stored in MongoDB
# and managed from the admin dashboard via the "All Sections" tab.

# Public origin of this frontend. BLANK = same-origin, which is correct for a
# Vercel deployment that rewrites /api to the backend and for local dev behind
# the Vite proxy. Never set this to a localhost or 127.0.0.1 value - it is
# inlined into the production bundle at build time and would point every
# production API request at a dev machine.
VITE_API_BASE_URL=

# Vite dev-server proxy target. Dev-only: the Vite server proxies /api to this
# address so the browser can stay on localhost:5173 while the API runs on
# localhost:5000. Has no effect on production builds.
VITE_PROXY_TARGET=http://localhost:5000

# Path to the site logo image served from the public/ directory.
VITE_LOGO_PATH=/superui_logo.png