# ============================================================================
# SuperUI - frontend build configuration TEMPLATE
#
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# LOCAL DEVELOPMENT: this file is optional. Every variable below has a working
# fallback in src/lib/env.js, and VITE_SITE_URL falls back to the origin the page
# was served from. Copy this file anyway - it documents what you can change.
#
# PRODUCTION (Vercel): .env is git-ignored and will NOT be deployed, so nothing
# in this file reaches the live site. Set these as environment variables instead:
# Vercel > Project > Settings > Environment Variables. A build with none of them
# still works, but VITE_SITE_URL, VITE_DEFAULT_TITLE, VITE_DEFAULT_DESCRIPTION
# and the VITE_BUSINESS_* values decide what search engines and AI answer
# engines see, so set them.
#
# SECURITY: never add ADMIN_USERNAME / ADMIN_PASSWORD / any secret here.
# Everything prefixed with VITE_ is inlined into the public JS bundle and is
# readable by any visitor. `.env` is git-ignored; only this template is
# committed.
# ============================================================================

# --- Dev server ------------------------------------------------------------
# Port the Vite dev/preview server binds to.
VITE_PORT=5173

# Interface the dev server binds to. Keep this as `localhost` unless you
# deliberately need LAN or container access - `0.0.0.0` exposes the source and
# the /api proxy to every device on the same network.
VITE_DEV_HOST=localhost

# Public origin of this frontend. Drives canonical URLs, Open Graph, sitemap and
# all structured data.
# Leave unset in production and it falls back to the deployed origin, which is
# usually right. Set it explicitly when the build must advertise a different
# canonical origin than the one it is served from.
VITE_SITE_URL=http://localhost:5173

# --- Backend ---------------------------------------------------------------
# API origin the Vite dev server proxies /api to.
VITE_PROXY_TARGET=http://localhost:5000

# API base URL used by the running app. Leave BLANK for same-origin /api, which
# is correct when Vercel rewrites /api to the backend (see vercel.json) and when
# developing behind the Vite proxy above.
#
# Setting this to a different origin makes the browser call that origin
# cross-origin. That fails with "No 'Access-Control-Allow-Origin' header" unless
# that backend lists this frontend's origin in CORS_ORIGINS, and because requests
# carry credentials: 'include', the session cookie additionally needs
# SameSite=None and Secure. Prefer same-origin /api plus a proxy rewrite.
VITE_API_BASE_URL=

# --- Branding --------------------------------------------------------------
VITE_SITE_NAME=SuperUI
VITE_SITE_ALT_NAME=SuperUI
VITE_LOGO_PATH=/superui_logo.png

# --- SEO / AEO / GEO defaults ---------------------------------------------
# Baked into the built JS. index.html carries the same values for crawlers that
# never run JavaScript, so change both together (or edit the `seo` section in
# Admin -> All Sections, which overrides both at runtime).
VITE_SITE_LOCALE=en_IN
VITE_DEFAULT_TITLE=SuperUI — Web Development, UI/UX Design & Custom Software Studio
VITE_DEFAULT_DESCRIPTION=SuperUI is a full-stack web development and UI/UX design studio in Warangal, Telangana, India. We build fast, secure, SEO-optimised websites, e-commerce stores and custom web applications. Get a fixed-price proposal within 24 hours.
VITE_SITE_KEYWORDS=web development company Warangal, custom web application development, UI UX design services India, ecommerce website development, React and Next.js developers, website maintenance and SEO services, SuperUI
VITE_OG_IMAGE=/superui_logo.png
# Quoted. An unquoted value starting with # is read as a comment by dotenv, so
# VITE_THEME_COLOR=#FF5E00 would load as an EMPTY string and the start-up config
# warning would report it as unset.
VITE_THEME_COLOR="#FF5E00"

# --- Public business coordinates used for GEO (local SEO) structured data. ----
# Keep CITY to the city name alone: the placename is built as
# "<city>, <countryName>", so "Warangal, Telangana, India." renders as
# "Warangal, Telangana, India., India".
VITE_CONTACT_EMAIL=hello@your-domain.com
VITE_CONTACT_PHONE=+910000000000
VITE_BUSINESS_CITY=Your City
VITE_BUSINESS_REGION=Your Region
VITE_BUSINESS_REGION_CODE=IN-XX
VITE_BUSINESS_COUNTRY=IN
VITE_BUSINESS_COUNTRY_NAME=India
VITE_BUSINESS_POSTAL_CODE=000000
VITE_BUSINESS_LATITUDE=0.0000
VITE_BUSINESS_LONGITUDE=0.0000
VITE_AREAS_SERVED=India

# --- Social profile links --------------------------------------------------
# Leave FACEBOOK/LINKEDIN blank and that footer icon is hidden. Absent values of
# this group never produce a start-up warning.
VITE_INSTAGRAM_URL=https://www.instagram.com/your-handle
VITE_INSTAGRAM_HANDLE=@your-handle
VITE_FACEBOOK_URL=
VITE_LINKEDIN_URL=

# --- Analytics / verification (optional) ----------------------------------
# Deliberately left out rather than present-and-blank. Google Search Console
# only accepts the token it issued for the property, so there is no useful
# placeholder; add the real one here for local testing, or as a Vercel
# environment variable for production. lib/seo.js injects it as
# <meta name="google-site-verification">. Absent is not an error and produces no
# warning.
# VITE_GSC_VERIFICATION=
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_GOOGLE_TAG_ID=
