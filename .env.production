# ============================================================================
# SuperUI - Frontend Production Environment Configuration
# ============================================================================
#
# VITE_* values are inlined into the JS bundle at build time. This file is
# used when the build machine runs `vite build` with NODE_ENV=production.
#
# The API base is BLANK on purpose: the Vercel rewrite in vercel.json routes
# /api/:path* to the Render backend, so requests from superui.in/api/...
# reach the backend automatically. Setting this to a Render URL would bypass
# Vercel and create a second code path to maintain.

VITE_API_BASE_URL=

# Public canonical origin of the frontend.
VITE_SITE_URL=https://superui.in

# Public branding & asset paths
VITE_LOGO_PATH=/superui_logo.png
VITE_THEME_COLOR=#FF5E00